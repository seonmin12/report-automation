__pycache__/
*.pyc
.venv/
venv/
.DS_Store
.vercel/

data/portal/*.xlsx
data/raw/*.csv
data/mapping/*.xlsx
!data/**/.gitkeep

output/*.xlsx
output/*.txt
output/*.png
output/*.eml
!output/.gitkeep

# benchmark/generate_dummy.py로 재현 가능한 대용량 산출물 (최대 수십만 행 xlsx/csv)이라
# git에는 안 올린다. benchmark/results/의 요약 결과(RESULTS.md 등)는 커밋 대상.
benchmark/data/*
!benchmark/data/.gitkeep
